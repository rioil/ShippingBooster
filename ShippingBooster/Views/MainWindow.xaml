<mah:MetroWindow x:Class="ShippingBooster.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:local="clr-namespace:ShippingBooster"
                 xmlns:vm="clr-namespace:ShippingBooster.ViewModels"
                 xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 mc:Ignorable="d"
                 Title="Shipping Booster" Height="600" Width="1000"
                 WindowStartupLocation="CenterScreen"
                 SaveWindowPosition="True"
                 GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
                 BorderThickness="1">
    <mah:MetroWindow.DataContext>
        <vm:MainWindowViewModel />
    </mah:MetroWindow.DataContext>

    <Grid Margin="10" RowDefinitions="Auto,Auto,*,Auto">
        <!-- 入力フォームセクション -->
        <GroupBox Grid.Row="0" Header="注文情報" Margin="0,0,0,10" Padding="15">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="120,*">

                <!-- 注文番号 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="注文番号:" VerticalAlignment="Center" Margin="0,5" />
                <TextBox Grid.Row="0" Grid.Column="1"
                         Text="{Binding OrderNo, UpdateSourceTrigger=PropertyChanged}"
                         mah:TextBoxHelper.ClearTextButton="True"
                         mah:TextBoxHelper.Watermark="注文番号を入力"
                         Margin="5" />

                <!-- 注文日 -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="注文日:" VerticalAlignment="Center" Margin="0,5" />
                <DatePicker Grid.Row="1" Grid.Column="1"
                            SelectedDate="{Binding OrderDate}"
                            Margin="5" />

                <!-- データ受付日 -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="データ受付日:" VerticalAlignment="Center" Margin="0,5" />
                <DatePicker Grid.Row="2" Grid.Column="1"
                            SelectedDate="{Binding DataReceivedDate}"
                            Margin="5" />

                <!-- 注文内容 -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="注文内容:" VerticalAlignment="Center" Margin="0,5" />
                <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding AvailableItems}"
                          SelectedItem="{Binding OrderItem}" Margin="5" />
            </Grid>
        </GroupBox>

        <!-- ボタンセクション -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button Content="プレビュー"
                    Command="{Binding PreviewCommand}"
                    Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"
                    Width="150" Height="40" Margin="5" />
            <Button Content="発送票を印刷"
                    Command="{Binding PrintShippingLabelCommand}"
                    Style="{DynamicResource MahApps.Styles.Button.Square}"
                    Width="150" Height="40" Margin="5" />
            <Button Content="レシートを印刷"
                    Command="{Binding PrintReceiptCommand}"
                    Style="{DynamicResource MahApps.Styles.Button.Square}"
                    Width="150" Height="40" Margin="5" />
        </StackPanel>

        <!-- プレビューセクション -->
        <Grid Grid.Row="2" Margin="0,0,0,10" ColumnDefinitions="*,5,*">
            <GroupBox Grid.Column="0" Header="発送票プレビュー" Padding="5">
                <Border BorderBrush="{DynamicResource MahApps.Brushes.Accent}" BorderThickness="1">
                    <svgc:SvgBitmap SvgSource="{Binding ShippingLabelSvg}" Margin="5" />
                </Border>
            </GroupBox>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="{DynamicResource MahApps.Brushes.Accent4}" />

            <GroupBox Grid.Column="2" Header="レシートプレビュー" Padding="5">
                <Border BorderBrush="{DynamicResource MahApps.Brushes.Accent}" BorderThickness="1">
                    <svgc:SvgBitmap SvgSource="{Binding ReceiptSvg}" Margin="5" />
                </Border>
            </GroupBox>
        </Grid>

        <!-- ステータスバー -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</mah:MetroWindow>